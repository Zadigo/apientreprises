{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "env": {
                "BASE_DIR": "${workspaceFolder}/apientreprises"
            }
        },
        {
            "name": "Python: Tests (pytest)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/.venv/bin/pytest",
            "args": [
                "--rootdir",
                "${workspaceFolder}/tests"
            ],
            "console": "integratedTerminal"
        }
    ]
}
